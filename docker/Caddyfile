# Caddy 配置：只服务管理面板这一个域名。
#
# Caddy 会自动向 Let's Encrypt 申请并续期证书（需要 adkms.lolicon.fans 的 A 记录
# 已经指向这台服务器，并且 80/443 从公网可达）。证书落在 caddy-data 卷里。
#
# KMS 本身（kms.lolicon.fans:1688）是裸 TCP，不经过 Caddy —— HTTP 反代处理不了
# 它，客户端也不需要 HTTPS。
#
# 面板改这个文件：Nimbus 容器把同一份文件挂进去，界面上的「域名与 HTTPS」读写
# 的就是它，保存后通过下面的 admin 端点热重载。

{
	# 面板（另一个容器）通过这个端点热重载配置。只在 compose 内网可达：
	# 没有 publish 到宿主机，公网也碰不到。不想让面板能改配置就删掉这一行，
	# 界面上会如实显示"没有自动重载通道"，保存只写文件。
	admin 0.0.0.0:2019
}

adkms.lolicon.fans {
	encode zstd gzip
	reverse_proxy kms:8099

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 3
		}
		format console
	}
}

# 别的服务的站点放单独文件里，见 caddy-sites/。这样 Nimbus 的「域名与 HTTPS」
# 页看到的永远只有它自己那一个站点块，不会被"有多个站点块，我不替你猜"挡住。
# 目录是只读挂进来的（compose 里 ./caddy-sites:/etc/caddy/sites:ro）。
import /etc/caddy/sites/*.caddy
